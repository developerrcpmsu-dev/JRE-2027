# JRE-2027 Environment Configuration
# Vercel & Supabase Settings

# Supabase Credentials (ตั้งค่าได้จาก Supabase Project Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Admin Authentication (Secret: กำหนดผ่าน Environment Variable บน Vercel หรือไฟล์ .env ของเซิร์ฟเวอร์เท่านั้น)
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_secure_admin_password
SESSION_SECRET=generate-a-random-32-byte-secret

# Google OAuth Client ID (จาก Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# OCR & Character Recognition APIs (AI For Thai / Google Cloud Vision)
AIFORTHAI_API_KEY=your_aiforthai_api_key
GOOGLE_VISION_API_KEY=your_google_cloud_vision_api_key
