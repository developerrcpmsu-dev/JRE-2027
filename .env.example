# JRE-2027 Environment Configuration
# Vercel & Supabase Settings

# Supabase Credentials (ตั้งค่าได้จาก Supabase Project Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Admin Authentication (กำหนดผ่าน Environment Variable บน Vercel หรือไฟล์ .env ส่วนตัว)
VITE_ADMIN_USERNAME=your_admin_username
VITE_ADMIN_PASSWORD=your_secure_admin_password

# Google OAuth Client ID (จาก Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
